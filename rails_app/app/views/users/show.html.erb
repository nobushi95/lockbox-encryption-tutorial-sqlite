<h1>ユーザー詳細</h1>

<% if notice %>
  <p><%= notice %></p>
<% end %>

<h2>復号化済み平文</h2>
<dl>
  <dt>ID</dt>
  <dd><%= @user.id %></dd>
  <dt>名前</dt>
  <dd><%= @user.name %></dd>
  <dt>メール</dt>
  <dd><%= @user.email %></dd>
  <dt>電話番号</dt>
  <dd><%= @user.phone %></dd>
</dl>

<h2>DB保存値（暗号文）</h2>
<dl>
  <dt>name_ciphertext</dt>
  <dd><code><%= @user.name_ciphertext %></code></dd>
  <dt>email_ciphertext</dt>
  <dd><code><%= @user.email_ciphertext %></code></dd>
  <dt>phone_ciphertext</dt>
  <dd><code><%= @user.phone_ciphertext %></code></dd>
</dl>

<%= link_to "一覧へ戻る", users_path %>
