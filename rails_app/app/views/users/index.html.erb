<h1>ユーザー一覧</h1>

<%= link_to "新規登録", new_user_path %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>名前</th>
      <th>メール</th>
      <th>電話</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.phone %></td>
        <td><%= link_to "詳細", user_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
